{
  "@context": {
    "@vocab": "https://rockbot.com/schema#",
    "schema": "https://schema.org/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "dcterms": "http://purl.org/dc/terms/",
    "rockbot": "https://rockbot.com/schema#",
    "ExportJob": "rockbot:ExportJob",
    "job_id": {
      "@id": "rockbot:job_id",
      "@type": "xsd:string"
    },
    "status": {
      "@id": "rockbot:status",
      "@type": "xsd:string"
    },
    "url": {
      "@id": "rockbot:url",
      "@type": "@id"
    },
    "expires_at": {
      "@id": "rockbot:expires_at",
      "@type": "xsd:dateTime"
    },
    "PaginatedResponse": "rockbot:PaginatedResponse",
    "total_count": {
      "@id": "rockbot:total_count",
      "@type": "xsd:integer"
    },
    "page_size": {
      "@id": "rockbot:page_size",
      "@type": "xsd:integer"
    },
    "page": {
      "@id": "rockbot:page",
      "@type": "xsd:integer"
    },
    "page_count": {
      "@id": "rockbot:page_count",
      "@type": "xsd:integer"
    },
    "data": {
      "@id": "rockbot:data",
      "@container": "@list"
    }
  },
  "@type": "schema:Dataset",
  "schema:name": "Rockbot API JSON-LD context",
  "schema:description": "A JSON-LD @context for the objects Rockbot's own API contract declares: one class per component schema, one property per declared field, typed from the contract. Derived by script (derive-json-ld.py, 2026-10-20) from openapi/rockbot-audio-messaging-api-openapi.yml, openapi/rockbot-auth-api-openapi.yml, openapi/rockbot-data-api-openapi.yml.",
  "dcterms:created": "2026-10-20",
  "dcterms:source": [
    "openapi/rockbot-audio-messaging-api-openapi.yml",
    "openapi/rockbot-auth-api-openapi.yml",
    "openapi/rockbot-data-api-openapi.yml",
    "openapi/rockbot-devices-api-openapi.yml",
    "openapi/rockbot-music-api-openapi.yml"
  ]
}