{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rockbot Audio Messaging Devices API",
    "version": "5.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.rockbot.com/v5/api-clients/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Devices",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve device operational metrics and configuration",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rockbot.com/v5/ext/devices/status"
          },
          "docs": "Retrieve device operational metrics and configuration"
        },
        {
          "info": {
            "name": "Fetch recent screen captures for a zone",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rockbot.com/v5/ext/devices/screenshots",
            "params": [
              {
                "name": "zone_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Fetch recent screen captures for a zone"
        },
        {
          "info": {
            "name": "Initiate remote device reboot",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.rockbot.com/v5/ext/devices/reboot"
          },
          "docs": "Initiate remote device reboot"
        }
      ]
    }
  ],
  "bundled": true
}