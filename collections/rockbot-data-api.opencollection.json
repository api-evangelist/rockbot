{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rockbot Audio Messaging Data API",
    "version": "5.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://api.rockbot.com/v5/api-clients/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Data",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Zone-level signage playback records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rockbot.com/v5/ext/data/signage/history",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size for paginated results."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Zero-based offset for paginated results."
              }
            ]
          },
          "docs": "Zone-level signage playback records"
        },
        {
          "info": {
            "name": "Zone-level music playback records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rockbot.com/v5/ext/data/music/history",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size for paginated results."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Zero-based offset for paginated results."
              }
            ]
          },
          "docs": "Zone-level music playback records"
        },
        {
          "info": {
            "name": "Zone-level messaging playback records",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rockbot.com/v5/ext/data/messaging/history",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Page size for paginated results."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Zero-based offset for paginated results."
              }
            ]
          },
          "docs": "Zone-level messaging playback records"
        },
        {
          "info": {
            "name": "Submit a group music-history export job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.rockbot.com/v5/ext/data/music/history/export"
          },
          "docs": "Submit a group music-history export job"
        },
        {
          "info": {
            "name": "Submit a group signage-history export job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.rockbot.com/v5/ext/data/signage/history/export"
          },
          "docs": "Submit a group signage-history export job"
        },
        {
          "info": {
            "name": "Submit a group messaging-history export job",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.rockbot.com/v5/ext/data/messaging/history/export"
          },
          "docs": "Submit a group messaging-history export job"
        },
        {
          "info": {
            "name": "Poll asynchronous export job status",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.rockbot.com/v5/ext/data/history/exports/:job_id",
            "params": [
              {
                "name": "job_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Poll asynchronous export job status"
        }
      ]
    }
  ],
  "bundled": true
}